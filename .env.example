# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Database (server-side only) — prefer Session/Transaction pooler if direct host is IPv6-only
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres

# Google reverse image enrichment — use at least one
GOOGLE_VISION_API_KEY=
SERPAPI_KEY=

# Optional: promote this email to admin after first signup
ADMIN_EMAIL=
